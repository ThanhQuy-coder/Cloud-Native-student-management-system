# Root Docker Compose environment template for local development.
# Copy to .env and adjust values if needed.

ASPNETCORE_ENVIRONMENT=Production

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173

# MySQL container initialization
MYSQL_ROOT_PASSWORD=Htq@12a2mysql
MYSQL_DATABASE=student_management
MYSQL_PORT=3306

# Shared database runtime defaults
Database__Host=localhost
Database__Port=3306
Database__User=root
Database__Password=Htq@12a2mysql

# Service database names from backend-microservices appsettings.Production.json
AUTH_DATABASE_NAME=student_management_auth
STUDENT_DATABASE_NAME=student_management_student
ACADEMIC_DATABASE_NAME=student_management_academic
ENROLLMENT_DATABASE_NAME=student_management_enrollment

# JWT runtime configuration
Jwt__Issuer=StudentManagementApi
Jwt__Audience=StudentManagementClient
Jwt__Key=local_development_secret_key_32_chars_minimum

# RabbitMQ container initialization
RABBITMQ_DEFAULT_USER=student_management
RABBITMQ_DEFAULT_PASS=123456
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ runtime configuration for .NET services on host machine
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=student_management
RabbitMQ__Password=123456
RabbitMQ__Exchange=student.events

# AuthService publishes StudentUserCreatedEvent
AUTH_RABBITMQ_QUEUE=student-service.student-user-created
AUTH_RABBITMQ_ROUTING_KEY=student.user.created

# StudentService consumes StudentUserCreatedEvent and publishes StudentProfileCreatedEvent
STUDENT_RABBITMQ_QUEUE=student-service.student-user-created
STUDENT_RABBITMQ_ROUTING_KEY=student.user.created
STUDENT_PROFILE_CREATED_EXCHANGE=student.events
STUDENT_PROFILE_CREATED_ROUTING_KEY=student.profile.created

# EnrollmentService consumes StudentProfileCreatedEvent
ENROLLMENT_RABBITMQ_QUEUE=enrollment-service.student-profile-created
ENROLLMENT_RABBITMQ_ROUTING_KEY=student.profile.created
